# ==============================================================================
# ENTORNO API - Radar Venezuela
# Copia este archivo a `.env` y ajusta según sea necesario.
# ==============================================================================

# Entorno de despliegue: "development", "staging", "production"
ENVIRONMENT=development

# Configuración de CORS estricta (importante para producción)
# Ejemplo: "https://radarvenezuela.org,http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Opcional: Secret para JWT o API keys si en el futuro se añade autenticación
# API_SECRET_KEY="tu_secreto_aqui_para_el_futuro"
