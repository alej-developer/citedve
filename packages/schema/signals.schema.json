{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alej-developer/radar-venezuela/packages/schema/signals.schema.json",
  "title": "Radar Venezuela — signals document",
  "description": "Contrato único de datos. Toda señal lleva fuente, fecha de captura y enlace, y se clasifica como hecho, rango entre fuentes o hipótesis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signals"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "captured_at"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "url": { "$ref": "#/$defs/httpUrl" },
        "captured_at": { "$ref": "#/$defs/isoDate" },
        "published_at": { "$ref": "#/$defs/isoDate" },
        "archive_url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edition",
        "domain",
        "indicator",
        "claim_type",
        "title",
        "statement",
        "observed_at",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
        "edition": { "$ref": "#/$defs/isoDate" },
        "domain": {
          "enum": ["fx", "inflation", "energy", "sanctions", "fintech", "ecommerce", "digital_infra"]
        },
        "indicator": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "claim_type": { "enum": ["fact", "range", "hypothesis"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "statement": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "range": { "$ref": "#/$defs/range" },
        "observed_at": { "$ref": "#/$defs/isoDate" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "claim_type": { "const": "range" } }, "required": ["claim_type"] },
          "then": {
            "required": ["range", "unit"],
            "properties": { "sources": { "minItems": 2 } }
          }
        },
        {
          "if": { "properties": { "claim_type": { "const": "hypothesis" } }, "required": ["claim_type"] },
          "then": { "required": ["confidence", "assumptions", "falsifiers"] }
        }
      ]
    }
  }
}
